    "text": "def main():\n    buff = HeapBuf(6)\n    buff[1] = 1\n    buff[GEN] = GEN\n    for x in mul_range(1, GEN ** 2):\n        b = x * x\n        f0 = buff[b]\n        f1 = buff[b * GEN]\n        f2 = f0 * f1\n        buff[b * GEN ** 2] = f1\n        buff[b * GEN ** 3] = f2\n    return\n"
