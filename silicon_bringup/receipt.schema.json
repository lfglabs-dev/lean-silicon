{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfglabs.dev/schemas/lean-silicon/lsc1u-bringup-receipt-v1.json",
  "title": "LSC-1u Tiny Tapeout bring-up receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution", "interface", "vectors", "observations", "oracle", "outcome"],
  "properties": {
    "schema": {"const": "lean-silicon.lsc1u-bringup-receipt.v1"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "real_silicon", "transport"],
      "properties": {
        "kind": {"enum": ["dry-run", "simulation"]},
        "real_silicon": {"const": false},
        "transport": {"type": "string"}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["top", "uio_oe", "abort", "reserved_input_bits"],
      "properties": {
        "top": {"const": "tt_um_lfglabs_lsc1u"},
        "uio_oe": {"const": "0xb6"},
        "abort": {"const": "synchronous rst_n=0 or ena=0; uio[6] is reserved and ignored"},
        "reserved_input_bits": {"const": [6]}
      }
    },
    "vectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "opcode", "received", "expected", "oracle_match", "retire_done_pulse", "idle_after_retire"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "opcode": {"enum": ["SET", "XOR", "MUL"]},
        "received": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "expected": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "oracle_match": {"type": "boolean"}, "retire_done_pulse": {"type": "boolean"},
        "idle_after_retire": {"type": "boolean"}
      }
    }},
    "oracle": {"type": "object", "additionalProperties": false, "required": ["algorithm", "matched"], "properties": {
      "algorithm": {"const": "independent GF(2^128), little-endian, low reduction 0x87"}, "matched": {"type": "boolean"}
    }},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["passed", "failures"], "properties": {
      "passed": {"type": "boolean"}, "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }}
  },
  "allOf": [
    {"if": {"properties": {"execution": {"properties": {"transport": {"const": "deterministic Python pin-model"}}}}}, "then": {"properties": {"execution": {"properties": {"kind": {"const": "dry-run"}, "real_silicon": {"const": false}}}}}}
  ]
}
