{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lean-silicon-conformance-v1",
  "title": "leanSilicon immutable conformance corpus v1",
  "type": "object",
  "$defs": {
    "hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
    "endpoint_state": {
      "type": "object",
      "required": [
        "txn_state", "profile", "committed_pc", "committed_fp", "state_valid",
        "retire_seq", "last_status", "last_fault", "abort_count"
      ],
      "properties": {
        "txn_state": {"type": "string"},
        "profile": {"type": "string"},
        "committed_pc": {"type": "integer", "minimum": 0},
        "committed_fp": {"type": "integer", "minimum": 0},
        "state_valid": {"type": "boolean"},
        "retire_seq": {"type": "integer", "minimum": 0},
        "last_status": {"type": "string"},
        "last_fault": {"type": "string"},
        "abort_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "write": {
      "type": "object",
      "required": ["address", "value"],
      "properties": {
        "address": {"type": "integer", "minimum": 0},
        "value": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      },
      "additionalProperties": false
    },
    "deferred": {
      "type": "object",
      "required": ["local", "target"],
      "properties": {
        "local": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "staged_transition": {
      "type": "object",
      "required": [
        "accesses", "deferred", "execute_cycles", "fp", "next_fp", "next_pc",
        "opcode", "pc", "profile", "result_crc32", "result_payload_hex",
        "txn_id", "writes"
      ],
      "properties": {
        "accesses": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "deferred": {
          "type": "array",
          "items": {"$ref": "#/$defs/deferred"}
        },
        "execute_cycles": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "next_fp": {"type": "integer", "minimum": 0},
        "next_pc": {"type": "integer", "minimum": 0},
        "opcode": {"type": "string", "minLength": 1},
        "pc": {"type": "integer", "minimum": 0},
        "profile": {"type": "string", "minLength": 1},
        "result_crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "result_payload_hex": {"$ref": "#/$defs/hex"},
        "txn_id": {"type": "integer", "minimum": 0},
        "writes": {
          "type": "array",
          "items": {"$ref": "#/$defs/write"}
        }
      },
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "required": ["payload_hex", "status"],
      "properties": {
        "payload_hex": {"$ref": "#/$defs/hex"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "retire": {
      "type": "object",
      "required": [
        "attempted", "request_hex", "response_hex", "response_status",
        "response_payload_hex", "cycles", "txn_id", "result_crc32",
        "retire_seq", "committed_pc", "committed_fp", "done_pulse"
      ],
      "properties": {
        "attempted": {"type": "boolean"},
        "request_hex": {"$ref": "#/$defs/hex"},
        "response_hex": {"$ref": "#/$defs/hex"},
        "response_status": {"type": ["string", "null"]},
        "response_payload_hex": {"$ref": "#/$defs/hex"},
        "cycles": {"type": "integer", "minimum": 0},
        "txn_id": {"type": ["integer", "null"], "minimum": 0},
        "result_crc32": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8}$"
        },
        "retire_seq": {"type": "integer", "minimum": 0},
        "committed_pc": {"type": "integer", "minimum": 0},
        "committed_fp": {"type": "integer", "minimum": 0},
        "done_pulse": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "upstream": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": {"const": "protocol_only"},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "adapter", "expected", "transition"],
          "properties": {
            "mode": {"const": "program_execute"},
            "adapter": {"const": "conformance/rust/frozen_adapter.rs"},
            "expected": {
              "type": "object",
              "required": ["cycles", "mem_used", "memory"],
              "properties": {
                "cycles": {"type": "integer", "minimum": 0},
                "mem_used": {"type": "integer", "minimum": 0},
                "memory": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
                }
              },
              "additionalProperties": false
            },
            "transition": {
              "type": "object",
              "required": ["next_pc", "next_fp", "writes"],
              "properties": {
                "next_pc": {"type": "integer", "minimum": 0},
                "next_fp": {"type": "integer", "minimum": 0},
                "writes": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/write"}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["schema", "frozen_upstream", "cases"],
  "properties": {
    "schema": {"const": "lean-silicon-conformance-v1"},
    "frozen_upstream": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "const": "https://github.com/leanEthereum/leanVM-b.git"
        },
        "commit": {
          "const": "c308034ab78619b39a59d26f3dc60e7df5b52649"
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id", "fingerprint", "description", "coverage", "raw",
          "initial_state", "final_state", "retire", "upstream"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "description": {"type": "string", "minLength": 1},
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "raw": {
            "type": "object",
            "required": ["request_hex", "response_hex"],
            "properties": {
              "request_hex": {"$ref": "#/$defs/hex"},
              "response_hex": {"$ref": "#/$defs/hex"},
              "request_cycles": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "initial_state": {"$ref": "#/$defs/endpoint_state"},
          "final_state": {"$ref": "#/$defs/endpoint_state"},
          "retire": {"$ref": "#/$defs/retire"},
          "upstream": {"$ref": "#/$defs/upstream"},
          "staged_transition": {"$ref": "#/$defs/staged_transition"},
          "fault": {"$ref": "#/$defs/fault"},
          "pre_action_state": {"$ref": "#/$defs/endpoint_state"},
          "lane": {
            "oneOf": [
              {
                "type": "object",
                "required": ["action", "rx_committed", "same_edge_rx_valid"],
                "properties": {
                  "action": {"const": "abort"},
                  "rx_committed": {"type": "boolean"},
                  "same_edge_rx_valid": {"type": "boolean"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "action", "rx_committed", "same_edge_abort", "same_edge_rx_valid"
                ],
                "properties": {
                  "action": {"const": "reset"},
                  "rx_committed": {"type": "boolean"},
                  "same_edge_abort": {"type": "boolean"},
                  "same_edge_rx_valid": {"type": "boolean"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "baseline_cycles", "response_matches_baseline", "rx_gaps",
                  "stalled_cycles", "tx_gaps"
                ],
                "properties": {
                  "baseline_cycles": {"type": "integer", "minimum": 0},
                  "response_matches_baseline": {"type": "boolean"},
                  "rx_gaps": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0}
                  },
                  "stalled_cycles": {"type": "integer", "minimum": 0},
                  "tx_gaps": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0}
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"case_id": {"pattern": "^(?:scalar\\.|protocol\\.)"}},
              "required": ["case_id"]
            },
            "then": {"required": ["staged_transition"]}
          },
          {
            "if": {
              "properties": {"case_id": {"pattern": "^(?:malformed\\.|error\\.)"}},
              "required": ["case_id"]
            },
            "then": {"required": ["fault"]}
          },
          {
            "if": {
              "properties": {"case_id": {"pattern": "^lane\\."}},
              "required": ["case_id"]
            },
            "then": {"required": ["lane"]}
          },
          {
            "if": {
              "properties": {"case_id": {"const": "lane.abort.priority"}},
              "required": ["case_id"]
            },
            "then": {"required": ["pre_action_state"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
