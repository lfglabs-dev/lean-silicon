__pycache__/
*.py[cod]
*.vvp
*.vcd
*.fst
*.log
*.json
!info.yaml
# Exported frozen-compiler program artifacts are checked-in source, not output.
!host/fixtures/*.json
# Immutable conformance inputs are reviewed source artifacts, not run output.
!conformance/*.json
# Reviewed assurance plans are source; mutable receipts remain in private caches.
!assurance/full-profile/plan.json
!assurance/full-profile/schema.json
!assurance/full-lsc1-netlist/plan.json
lean/.lake/
formal/gf8_mul/
formal/gf128_serialize/
formal/gf128_serialize_bmc/
formal/gf128_serialize_induction/
formal/gf128_serialize_cover/
formal/stream_alu_mul_pulse/
formal/stream_alu_mul_pulse_induction/
formal/stream_alu_mul_pulse_cover/
formal/lsc1u_protocol_bmc/
formal/lsc1u_protocol_cover/
formal/full_lsc1_deref_bridge/
test/results.xml
test/sim_build/
.venv/
openlane/
reports/
tools/blake3_reference/target/

# Scratch outputs of the ULX3S build scripts. The scripts archive the copies
# that matter under results/.
fpga/ulx3s/smoke_top.*
fpga/ulx3s/ulx3s_top.*
!fpga/ulx3s/smoke_top.sv
!fpga/ulx3s/ulx3s_top.sv

# Archived build evidence. The blanket *.log rule above would otherwise drop
# the synthesis and route logs that make an immutable bitstream reviewable.
!results/**/*.log

# ecppack is silent on success; an empty log is not evidence.
results/**/ecppack*.log
results/.ulx3s-smoke-uart.publish.lock
