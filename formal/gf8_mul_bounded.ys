# Finite M0 check: all RTL and the sole assertion remain unchanged.
read_verilog -formal -sv ../asic_core/rtl/gf2n_mul_bitstream.sv gf8_mul_formal.sv
prep -top gf8_mul_formal
# The Yosys SAT backend does not import cover cells.  The cover is not an
# assertion and does not constrain the model, so remove only that reporting cell.
chformal -remove -cover
flatten
opt
select -module gf8_mul_formal
# Frame 21 is the first assertion frame; -seq 22 includes frames 0 through 22.
sat -seq 22 -prove-asserts -verify
