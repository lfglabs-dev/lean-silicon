[tasks]
bmc
induction
cover

[options]
# The harness drives one closed transaction and then holds a terminal phase,
# so depth 80 covers every step at which the assertion can be evaluated.
bmc: mode bmc
bmc: depth 80
induction: mode prove
induction: depth 80
cover: mode cover
cover: depth 80
multiclock on
timeout 900
vcd off

[engines]
bmc: smtbmc yices
induction: smtbmc yices
cover: smtbmc yices

[script]
# [files] are copied into the SBY work directory; use their local basenames.
read -formal gf2n_mul_bitstream.sv gf128_mul_bitstream.sv gf128_serialize_formal.sv
prep -top gf128_serialize_formal

[files]
../asic_core/rtl/gf2n_mul_bitstream.sv
../asic_core/rtl/gf128_mul_bitstream.sv
gf128_serialize_formal.sv
