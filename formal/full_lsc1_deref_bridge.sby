[tasks]
safety
reachability
accepted_result_reachability
matching_retire_reachability
accepted_result_safety
matching_retire_safety
post_retire_safety

[options]
safety: mode bmc
safety: depth 20
reachability: mode cover
reachability: depth 2788
accepted_result_reachability: mode cover
accepted_result_reachability: depth 2767
matching_retire_reachability: mode cover
matching_retire_reachability: depth 2787
accepted_result_safety: mode bmc
accepted_result_safety: depth 2767
matching_retire_safety: mode bmc
matching_retire_safety: depth 2787
post_retire_safety: mode bmc
post_retire_safety: depth 2788
multiclock off

[engines]
safety: smtbmc boolector
reachability: btor btormc
accepted_result_reachability: btor btormc
matching_retire_reachability: btor btormc
# Keep arbitrary RTL power-up state symbolic; the AIG backend rejects it
# before the required sampled reset can establish the witness invariants.
accepted_result_safety: btor btormc
matching_retire_safety: btor btormc
post_retire_safety: btor btormc

[script]
read -formal -D FORMAL_DEREF_BRIDGE lsc1_packet_rx.sv
read -formal -D FORMAL_DEREF_BRIDGE lsc1_packet_tx.sv
read -formal -D FORMAL_DEREF_BRIDGE gf2n_mul_bitstream.sv
read -formal -D FORMAL_DEREF_BRIDGE gf128_mul_bitstream.sv
read -formal -D FORMAL_DEREF_BRIDGE leanvm_b_stream_alu.sv
read -formal -D FORMAL_DEREF_BRIDGE lsc1_stream_adapter.sv
read -formal -D FORMAL_DEREF_BRIDGE lsc1_field_encoder.sv
read -formal -D FORMAL_DEREF_BRIDGE lsc1_blake3_lifecycle.sv
safety: read -formal -D FORMAL_DEREF_BRIDGE full_lsc1_deref_bridge_checker.sv
reachability: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY full_lsc1_deref_bridge_checker.sv
accepted_result_reachability: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY -D FORMAL_DEREF_ACCEPTED_RESULT full_lsc1_deref_bridge_checker.sv
matching_retire_reachability: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY -D FORMAL_DEREF_MATCHING_RETIRE full_lsc1_deref_bridge_checker.sv
accepted_result_safety: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY -D FORMAL_DEREF_ACCEPTED_RESULT full_lsc1_deref_bridge_checker.sv
matching_retire_safety: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY -D FORMAL_DEREF_MATCHING_RETIRE full_lsc1_deref_bridge_checker.sv
post_retire_safety: read -formal -D FORMAL_DEREF_BRIDGE -D FORMAL_DEREF_REACHABILITY -D FORMAL_DEREF_POST_RETIRE full_lsc1_deref_bridge_checker.sv
read -formal -D FORMAL_DEREF_BRIDGE lsc1_response_payload_mux.sv lsc1_blake3_alias_check.sv lsc1_packet_frontend.sv
prep -top lsc1_packet_frontend
# `prep` has already concretized every parameter in this closed hierarchy.
# Rewriting parameter constants is therefore unnecessary, and Yosys 0.57
# aborts in setundef.cc when the witness harness is present.  Keep undriven
# nets symbolic; this does not change RTL initialization or witness bounds.
setundef -undriven -anyseq
opt_clean

[files]
full_lsc1_deref_bridge_checker.sv
../asic_core/rtl/lsc1_packet_rx.sv
../asic_core/rtl/lsc1_packet_tx.sv
../asic_core/rtl/lsc1_response_payload_mux.sv
../asic_core/rtl/lsc1_blake3_alias_check.sv
../asic_core/rtl/gf2n_mul_bitstream.sv
../asic_core/rtl/gf128_mul_bitstream.sv
../asic_core/rtl/leanvm_b_stream_alu.sv
../asic_core/rtl/lsc1_stream_adapter.sv
../asic_core/rtl/lsc1_field_encoder.sv
../asic_core/rtl/lsc1_blake3_lifecycle.sv
../asic_core/rtl/lsc1_packet_frontend.sv
