[tasks]
bounded
prove
induction
cover

[options]
bounded: mode bmc
# Frame 0 establishes the initial reset; frames 1..74 are assertion-active.
bounded: depth 75
prove: mode prove
induction: mode prove
induction: depth 4
cover: mode cover
cover: depth 200
timeout 1800
vcd off

[engines]
bounded: abc bmc3
prove: abc pdr
induction: smtbmc boolector
cover: smtbmc boolector

[script]
read_verilog -formal -sv gf2n_mul_bitstream.sv gf128_mul_bitstream.sv lsc1u_core.sv tt_um_lfglabs_lsc1u.sv
rename tt_um_lfglabs_lsc1u lsc1u_rtl
flatten lsc1u_rtl
expose lsc1u_rtl/w:\\core.state lsc1u_rtl/w:\\core.byte_index lsc1u_rtl/w:\\core.saved_byte lsc1u_rtl/w:\\core.out_byte lsc1u_rtl/w:\\core.out_valid lsc1u_rtl/w:\\core.fault_reg lsc1u_rtl/w:\\core.done_reg lsc1u_rtl/w:\\core.multiplier.impl.a_shift lsc1u_rtl/w:\\core.multiplier.impl.accumulator
read_verilog -formal sky130_fd_sc_hd_netlist_eq_cells.v selected_tt_um_lfglabs_lsc1u.v
rename tt_um_lfglabs_lsc1u lsc1u_gate_raw
expose lsc1u_gate_raw/w:\\core.state* lsc1u_gate_raw/w:\\core.byte_index* lsc1u_gate_raw/w:\\core.saved_byte* lsc1u_gate_raw/w:\\core.out_byte* lsc1u_gate_raw/w:\\core.out_valid lsc1u_gate_raw/w:\\core.fault_reg lsc1u_gate_raw/w:\\core.done_reg lsc1u_gate_raw/w:\\core.mul_result_byte* lsc1u_gate_raw/w:\\core.multiplier.impl.a_shift* lsc1u_gate_raw/w:\\core.multiplier.impl.accumulator*
read_verilog -formal -sv lsc1u_release_gate_wrapper.sv
read_verilog -formal -sv lsc1u_release_netlist_eq_formal.sv
select lsc1u_gate_raw/ANTENNA_* lsc1u_gate_raw/FILLER_* lsc1u_gate_raw/PHY_* lsc1u_gate_raw/TAP_*
delete
select -clear
prep -flatten -top lsc1u_release_netlist_eq_formal
bounded: chformal -assert -remove c:*state_correspondence*
bounded: select -assert-count 3 c:$assert*
prove: select -assert-count 4 c:$assert* c:state_correspondence
induction: select -assert-count 4 c:$assert* c:state_correspondence
cover: select -assert-count 4 c:$assert* c:state_correspondence
cover: select -assert-count 4 c:$cover*

[files]
../src/gf2n_mul_bitstream.sv
../src/gf128_mul_bitstream.sv
../src/lsc1u_core.sv
../src/tt_um_lfglabs_lsc1u.sv
selected_tt_um_lfglabs_lsc1u.v
sky130_fd_sc_hd_netlist_eq_cells.v
lsc1u_release_netlist_eq_formal.sv
lsc1u_release_gate_wrapper.sv
