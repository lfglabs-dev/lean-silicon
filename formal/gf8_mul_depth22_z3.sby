[options]
mode bmc
depth 22
multiclock on
timeout 15

[engines]
# Diagnostic only: Z3 supports the `anyconst` quantifier but stalls at frame 21.
smtbmc z3

[script]
# [files] are copied into the SBY work directory; use their local basenames.
read -formal gf2n_mul_bitstream.sv gf8_mul_formal.sv
prep -top gf8_mul_formal

[files]
../asic_core/rtl/gf2n_mul_bitstream.sv
gf8_mul_formal.sv
