LOCATE COMP "ftdi_txd" SITE "M1";
IOBUF PORT "ftdi_txd" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF PORT "ftdi_rxd" IO_TYPE=LVCMOS33 DRIVE=4;
